PORT=4000

# Comma-separated list of allowed origins for browser clients (dev/E2E)
# Example: http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
DATABASE_URL="file:./dev.db"
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="15m"
NODE_ENV=development
