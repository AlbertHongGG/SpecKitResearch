{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:cov": "cross-env COVERAGE_RUNTIME=1 c8 --temp-directory .c8_output --reporter none tsx src/main.ts",
    "cov:clean": "node ../../scripts/coverage/clean.mjs",
    "cov:report": "node ../../scripts/coverage/report.mjs",
    "build": "tsup",
    "start": "node --enable-source-maps dist/main.js",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@app/canonicalization": "*",
    "@app/contracts": "*",
    "@app/logic-engine": "*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.1",
    "@types/supertest": "^6.0.3",
    "c8": "^10.1.3",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "tsup": "^8.4.0",
    "tsx": "^4.19.2",
    "uuid": "^11.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
